---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { profile } from "../content/career";
import { useTranslations, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/**
 * The portrait is optional. Drop a file at `src/assets/portrait.{jpg,png,webp}`
 * and the hero becomes two columns; with no file the type simply takes the full
 * width rather than leaving a hole.
 */
const found = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/portrait.{jpg,jpeg,png,webp}",
  { eager: true },
);
const portrait = Object.values(found)[0]?.default ?? null;
---

<section class="hero" aria-labelledby="hero-name">
  <div class:list={["shell", "hero-inner", portrait && "has-portrait"]}>
    {/*
      DOM order is copy → portrait → actions so that stacked on a phone it
      reads name, motto, face, call to action. Desktop re-associates them with
      grid areas rather than reordering, keeping source order and reading order
      identical for assistive tech.
    */}
    <div class="copy">
      <p class="role" data-reveal>{t.hero.role}</p>

      <h1 id="hero-name" class="name" data-reveal-text>{profile.name}</h1>

      {/*
        Youssef's own words, in English in every locale. The one line on the
        site that is never translated and never edited.
      */}
      <p class="motto" lang="en" data-reveal-text>{t.hero.motto}</p>
    </div>

    {
      portrait && (
        <figure class="portrait" data-reveal>
          {/*
            The source is 463x740, so at 18rem the frame is still downscaling —
            upscaling a portrait is far more obvious than a slightly small one.
          */}
          <Image
            src={portrait}
            alt={t.about.portraitAlt}
            widths={[288, 463]}
            sizes="(min-width: 60rem) 18rem, 55vw"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )
    }

    <div class="actions" data-reveal>
      <a class="cta" href="#contact" data-magnetic>
        <span>{t.hero.cta}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: clamp(6rem, 14vh, 9rem) clamp(5rem, 12vh, 8rem);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  /* Portrait beside the name from tablet up; stacked on phones, where a
     side-by-side would squeeze the name past legibility. Grid areas put the
     CTA back under the copy without touching DOM order. */
  @media (min-width: 60rem) {
    .has-portrait {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 22rem;
      grid-template-areas:
        "copy portrait"
        "actions portrait";
      align-items: center;
      column-gap: clamp(3rem, 7vw, 6rem);
      row-gap: 0;
    }

    .has-portrait .copy {
      grid-area: copy;
      align-self: end;
    }

    .has-portrait .portrait {
      grid-area: portrait;
    }

    .has-portrait .actions {
      grid-area: actions;
      align-self: start;
    }
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .role {
    font-size: var(--text-small);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-block-end: clamp(1.5rem, 4vw, 2.5rem);
  }

  .name {
    font-size: var(--text-hero);
    /* Fraunces at display size: heavier optical weight, tighter tracking. */
    font-variation-settings: "opsz" 144, "SOFT" 0, "WONK" 1;
    letter-spacing: -0.035em;
    max-width: 12ch;
  }

  .motto {
    font-family: var(--font-display);
    font-size: var(--text-lead);
    font-style: italic;
    color: var(--color-ink-muted);
    max-width: 26ch;
    line-height: 1.45;
    margin-block-start: clamp(1.5rem, 3.5vw, 2.25rem);
  }

  .actions {
    margin-block-start: clamp(2.5rem, 6vw, 4rem);
  }

  /* Gold appears here as a 1px border only — never as a fill. */
  .cta {
    display: inline-flex;
    align-items: center;
    padding: 0.9rem 2rem;
    border: 1px solid var(--color-accent);
    border-radius: 999px;
    font-size: var(--text-small);
    letter-spacing: 0.06em;
    color: var(--color-ink);
    position: relative;
    overflow: hidden;
    transition:
      color var(--duration-fast) var(--ease-in-out-quart),
      border-color var(--duration-fast) var(--ease-in-out-quart);
  }

  .cta::before {
    content: "";
    position: absolute;
    inset: 0;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: inline-start;
    transition: transform var(--duration-base) var(--ease-out-expo);
  }

  .cta span {
    position: relative;
    z-index: 1;
  }

  .cta:hover {
    color: var(--color-bg);
  }

  .cta:hover::before {
    transform: scaleX(1);
  }

  .portrait {
    margin: 0;
    flex-shrink: 0;
    width: min(55vw, 13rem);
    position: relative;
  }

  @media (min-width: 60rem) {
    .portrait {
      width: 18rem;
    }
  }

  /* A single gold hairline offset behind the frame — the accent's one
     appearance in the hero besides the CTA border. */
  .portrait::after {
    content: "";
    position: absolute;
    inset-block: 1.25rem -1.25rem;
    inset-inline: 1.25rem -1.25rem;
    border: 1px solid var(--color-accent-soft);
    border-radius: 2px;
    z-index: -1;
  }

  /* 5:8, matching the 463x740 crop closely enough that `cover` trims nothing
     meaningful. */
  .portrait :global(img) {
    width: 100%;
    aspect-ratio: 5 / 8;
    object-fit: cover;
    border-radius: 2px;
    /* This photo's background is a warm peach — the most saturated thing on
       the page — so it needs pulling toward the palette rather than the light
       touch a neutral studio backdrop would want. */
    filter: saturate(0.86) contrast(1.03);
    transition: filter var(--duration-fast) var(--ease-in-out-quart);
  }

  /* That same peach glares against a near-black ground, so it is dimmed. */
  :global(:root[data-theme="dark"]) .portrait :global(img) {
    filter: saturate(0.74) contrast(1.02) brightness(0.82);
  }
</style>
