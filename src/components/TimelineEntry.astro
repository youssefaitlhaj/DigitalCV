---
import type { Role } from "../content/schema";
import { formatDuration, formatRange, isoFor } from "../lib/dates";
import { useTranslations, type Locale } from "../i18n";

interface Props {
  role: Role;
  locale: Locale;
}

const { role, locale } = Astro.props;
const t = useTranslations(locale);

const title = t.experience.titles[role.id];
const description = t.experience.descriptions[role.id];
const range = formatRange(role, locale, t);
const duration = formatDuration(role, t);
const isCurrent = role.end === "present";
---

<li class:list={["entry", isCurrent && "current"]} data-reveal>
  <span class="node" data-timeline-node aria-hidden="true"></span>

  <div class="body">
    <p class="dates">
      <time datetime={isoFor(role.start)}>{range.split(" — ")[0]}</time>
      <span aria-hidden="true">—</span>
      <time datetime={isoFor(role.end)}>{range.split(" — ")[1]}</time>
      <span class="duration">{duration}</span>
    </p>

    <h3 class="title">{title}</h3>

    <p class="employer">
      {
        role.employerUrl ? (
          <a href={role.employerUrl} target="_blank" rel="noopener noreferrer">
            {role.employer}
          </a>
        ) : (
          role.employer
        )
      }
      <span class="badge">{t.experience.employment[role.employment]}</span>
      <span class="location">{role.location}</span>
    </p>

    <p class="description">{description}</p>
  </div>
</li>

<style>
  .entry {
    position: relative;
    /* Logical padding, so the rail sits on the correct side in any direction. */
    padding-inline-start: clamp(1.75rem, 4vw, 2.75rem);
    padding-block-end: clamp(2.75rem, 6vw, 4rem);
  }

  .entry:last-child {
    padding-block-end: 0;
  }

  .node {
    position: absolute;
    inset-block-start: 0.55rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background-color: var(--color-bg);
    border: 1px solid var(--color-hairline);
    /* Sit on the rail's centre line (the rail is 2px wide from the same inline
       edge, so its axis is 1px in) and pull back by half the node's own width.
       Expressed as a percentage rather than a pixel offset so it stays centred
       if the node or rail is ever resized. */
    inset-inline-start: 1px;
    transform: translateX(-50%);
    transition:
      background-color var(--duration-fast) var(--ease-out-expo),
      border-color var(--duration-fast) var(--ease-out-expo),
      box-shadow var(--duration-fast) var(--ease-out-expo);
  }

  /* `inset-inline-start` already flips with direction; only the pull-back has
     to be mirrored, since translateX is physical. */
  :global([dir="rtl"]) .node {
    transform: translateX(50%);
  }

  /* Lit as the gold rail passes each node — the class is toggled from the
     rail's own scrub progress in motion.ts, so the two can never drift apart.
     With no motion layer there is nothing to scrub, so every node is lit. */
  .node.is-reached,
  :global(html:not(.js-motion)) .node {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* The active role keeps its halo, so it still reads as distinct once the
     rail has lit everything above it. */
  .current .node {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-accent) 18%, transparent);
  }

  .dates {
    font-size: var(--text-eyebrow);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-variant-numeric: tabular-nums;
  }

  .duration {
    padding-inline-start: 0.5rem;
    border-inline-start: 1px solid var(--color-hairline);
    color: var(--color-ink-muted);
  }

  .title {
    font-size: var(--text-heading);
    margin-block-start: 0.6rem;
  }

  .employer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    margin-block-start: 0.35rem;
    font-size: var(--text-small);
  }

  .employer a {
    border-block-end: 1px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-in-out-quart);
  }

  .employer a:hover {
    border-block-end-color: var(--color-accent);
  }

  .location {
    color: var(--color-ink-muted);
  }

  /* Distinguishes the six-month full-time role from the six-and-a-half-year
     part-time one, and marks the Moroccan roles as internships — without which
     the timeline reads as five equivalent jobs. */
  .badge {
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--color-hairline);
    border-radius: 999px;
    font-size: var(--text-eyebrow);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    white-space: nowrap;
  }

  .description {
    margin-block-start: 0.9rem;
    color: var(--color-ink-muted);
    max-width: 46ch;
  }
</style>
