---
import { useTranslations, type Locale } from "../../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

{/*
  A switch rather than two radio buttons: there are only two states and the
  icon shows which one is active. `aria-pressed` is set by theme.ts once it
  knows what the inline script resolved.
*/}
<button
  type="button"
  class="toggle"
  data-theme-toggle
  aria-pressed="false"
  title={t.nav.theme}
>
  <span class="sr-only">{t.nav.theme}</span>

  <svg class="icon sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4.2"></circle>
    <g stroke-linecap="round">
      <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2"></path>
      <path d="M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6"></path>
    </g>
  </svg>

  <svg class="icon moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2z"></path>
  </svg>
</button>

<style>
  .toggle {
    display: grid;
    place-items: center;
    width: 1.95rem;
    height: 1.95rem;
    padding: 0;
    margin-inline-start: 0.1rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--color-ink-muted);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-in-out-quart);
  }

  .toggle:hover {
    color: var(--color-accent);
  }

  /* Both icons occupy the same cell; only one is visible at a time. */
  .icon {
    grid-area: 1 / 1;
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    transition:
      opacity var(--duration-fast) var(--ease-in-out-quart),
      transform var(--duration-base) var(--ease-out-expo);
  }

  /* Show the icon for the theme you would switch TO, which is the convention
     users expect from a single-button toggle. */
  .sun {
    opacity: 0;
    transform: rotate(-70deg) scale(0.6);
  }

  .moon {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  :global(:root[data-theme="dark"]) .sun {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  :global(:root[data-theme="dark"]) .moon {
    opacity: 0;
    transform: rotate(70deg) scale(0.6);
  }
</style>
