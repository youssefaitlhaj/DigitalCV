---
import SectionHeading from "./ui/SectionHeading.astro";
import TimelineEntry from "./TimelineEntry.astro";
import { roles } from "../content/career";
import { useTranslations, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="experience" class="section" aria-labelledby="experience-heading">
  <div class="shell">
    <SectionHeading index="02" title={t.sections.experience} id="experience" />

    <ol class="timeline">
      {/* The rail sits behind the entries and is drawn in as the section scrolls. */}
      <span class="rail" aria-hidden="true"><span class="rail-fill" data-timeline-rail></span></span>

      {roles.map((role) => <TimelineEntry role={role} locale={locale} />)}
    </ol>
  </div>
</section>

<style>
  .section {
    padding-block: var(--spacing-section);
    background-color: var(--color-surface);
  }

  .timeline {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 52rem;
  }

  .rail {
    position: absolute;
    inset-block: 0.55rem 0;
    inset-inline-start: 0;
    /* 2px rather than 1px: the fill is the one element meant to be watched as
       it draws, and a hairline is too easy to miss in peripheral vision. */
    width: 2px;
    background-color: var(--color-hairline);
    border-radius: 999px;
  }

  /* Solid gold, full strength. This previously faded to 25% transparent toward
     the bottom, which meant the part actively being drawn was also the least
     visible part — exactly backwards for a progress indicator. */
  .rail-fill {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: 100%;
    background-color: var(--color-accent);
    border-radius: 999px;
    transform-origin: top;
  }

  /* Only pre-collapse the rail when the motion layer will animate it back. */
  :global(.js-motion) .rail-fill {
    transform: scaleY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js-motion) .rail-fill {
      transform: none;
    }
  }
</style>
