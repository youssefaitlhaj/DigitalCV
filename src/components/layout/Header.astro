---
import { pathFor, type Locale } from "../../i18n/locales";
import type { Content } from "../../content/repository";
import LocaleSwitcher from "./LocaleSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";
import SectionNav from "./SectionNav.astro";

interface Props {
  content: Content;
  locale: Locale;
  path?: string;
}

const { content, locale, path = "/" } = Astro.props;
const { site } = content;
const logoParts = site.logoText.split(".");
---

<div class="progress" data-progress aria-hidden="true"></div>

<header class="site-header">
  <div class="shell bar">
    <a class="logo" href={pathFor(locale)}>
      {logoParts.map((part, i) => (<>{i > 0 && <span>.</span>}{part}</>))}
    </a>
    <div class="tools">
      <LocaleSwitcher site={site} locale={locale} path={path} />
      <ThemeToggle site={site} locale={locale} />
    </div>
  </div>
</header>

{/* The section links live in the floating bar at the bottom of the viewport. */}
<SectionNav content={content} locale={locale} />

<style>
  /* Scroll progress only exists with the motion layer (html.motion); it has no final state to show. */
  .progress {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 100%;
    background: var(--accent);
    transform-origin: 0 50%;
    z-index: 40;
  }
  :global(.motion) .progress {
    display: block;
    transform: scaleX(0);
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: var(--header-h);
    gap: 12px;
  }
  .logo {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
  }
  .logo span {
    color: var(--accent-text);
  }
  .tools {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  @media (max-width: 400px) {
    .shell {
      padding: 0 16px;
    }
  }
</style>

<style is:global>
  .ctrl {
    font-family: var(--font-mono);
    font-size: 12px;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 4px 9px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
</style>
