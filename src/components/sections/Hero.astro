---
import Img from "../layout/Img.astro";
import { anchorFor, visibleSections } from "../../lib/sections";
import { pick } from "../../lib/localize";
import type { Content } from "../../content/repository";
import type { SectionOf } from "../../content/schemas/registry";
import type { Locale } from "../../i18n/locales";

interface Props {
  section: SectionOf<"hero">;
  locale: Locale;
  content: Content;
}

const { section, locale, content } = Astro.props;
const { site } = content;

const city = pick(site.location, locale).split(",")[0].trim().toLowerCase();
const cvHref = `/cv/${site.pdf.fileBaseName}-${locale}.pdf`;
// "Contact me" targets the contact section, and disappears with it when hidden.
const contact = visibleSections(content.page.sections).find((s) => s.type === "contact");
const cardName = `${site.logoText.split(".")[0]}.json`;
const entries = section.jsonCard.map((e) => ({ key: e.key, values: e.values.map((v) => JSON.stringify(pick(v, locale))) }));
---

{/*
  Motion hooks only (Task 10 animates them): nothing here is hidden by CSS, so
  with JavaScript off or reduced motion the hero is already in its final state.
  The name stays plain text; the motion layer splits letters at runtime.
*/}
<section
  id={anchorFor(section.id)}
  data-section={section.type}
  data-animate={String(section.animate)}
  class="hero"
>
  <div class="shell grid">
    <div>
      <div class="prompt mono" data-intro="prompt"><b>~/{city}</b> $ <span data-intro="cmd">{section.prompt}</span></div>
      <h1 data-intro="name"><span data-name>{site.name}</span><span class="cur" aria-hidden="true"></span></h1>
      <div class="role" data-intro="fade">{pick(section.role, locale)}</div>
      <p class="sub" data-intro="fade">{pick(section.subtitle, locale)}</p>
      {section.showMotto && <p class="motto" data-intro="fade">{pick(section.motto, locale)}</p>}
      <div class="btns" data-intro="fade">
        <a class="btn p" href={cvHref} data-umami-event="cv-download" data-umami-event-lang={locale}>
          <span aria-hidden="true">↓</span>{pick(section.ctaPrimary, locale)}
        </a>
        {contact && <a class="btn s" href={`#${anchorFor(contact.id)}`}>{pick(section.ctaSecondary, locale)}</a>}
      </div>
      {
        entries.length > 0 && (
          <div class="code" data-intro="fade">
            <div class="bar"><span>{cardName}</span><span class="ok" data-intro="ok">✓ valid</span></div>
            <pre data-intro="json"><span class="ln">{"{"}</span>{entries.map((e, i) => <span class="ln">{`  "${e.key}": `}{e.values.length === 1 ? <span class="s">{e.values[0]}</span> : <>[{e.values.map((v, j) => <>{j > 0 && ", "}<span class="s">{v}</span></>)}]</>}{i < entries.length - 1 && ","}</span>)}<span class="ln">{"}"}</span></pre>
          </div>
        )
      }
    </div>
    <div class="photo" data-intro="photo">
      <Img image={section.portrait} locale={locale} widths={[300, 463]} sizes="(max-width: 820px) 180px, 300px" eager />
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: center;
    padding: 48px 0;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 56px;
    align-items: center;
    width: 100%;
  }
  .prompt {
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 14px;
    min-height: 1.6em;
  }
  .prompt b {
    color: var(--accent-text);
    font-weight: 500;
  }
  h1 {
    font-size: clamp(46px, 7.4vw, 84px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
    margin: 0;
  }
  .cur {
    display: inline-block;
    width: 0.42em;
    height: 0.82em;
    background: var(--accent);
    vertical-align: -0.04em;
    margin-left: 6px;
    /* Takes no width, so the cursor never wraps onto a line of its own. */
    margin-right: calc(-0.42em - 6px);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .role {
    font-size: 22px;
    font-weight: 600;
    color: var(--accent-text);
    margin-top: 18px;
  }
  .sub {
    color: var(--muted);
    max-width: 560px;
    margin: 12px 0 0;
    font-size: 18px;
  }
  .motto {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--muted);
    margin: 12px 0 0;
  }
  .photo {
    width: 300px;
    aspect-ratio: 4 / 5;
    border-radius: 14px;
    overflow: hidden;
    position: relative;
  }
  .photo :global(img) {
    width: 100%;
    height: 115%;
    object-fit: cover;
    display: block;
  }
  .code {
    margin-top: 30px;
    max-width: 560px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    font-family: var(--font-mono);
    font-size: 13.5px;
    overflow: hidden;
  }
  .code .bar {
    padding: 8px 14px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 12px;
    display: flex;
    justify-content: space-between;
  }
  .code .ok,
  .code .s {
    color: var(--accent-text);
  }
  .code pre {
    margin: 0;
    padding: 14px 16px;
    line-height: 1.75;
    overflow-x: auto;
    font-family: inherit;
  }
  .ln {
    display: block;
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .photo {
      width: 180px;
      order: -1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cur {
      animation: none;
    }
  }
</style>
