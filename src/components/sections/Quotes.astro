---
import SectionFrame from "../layout/SectionFrame.astro";
import RichText from "../layout/RichText.astro";
import Img from "../layout/Img.astro";
import { pick } from "../../lib/localize";
import type { Content } from "../../content/repository";
import type { SectionOf } from "../../content/schemas/registry";
import type { Locale } from "../../i18n/locales";

interface Props {
  section: SectionOf<"quotes">;
  locale: Locale;
  content: Content;
}

const { section, locale } = Astro.props;
---

<SectionFrame section={section} locale={locale}>
  <ul class="quotes">
    {
      section.items.map((item) => (
        <li>
          <figure class="quote">
            <blockquote>
              <RichText value={item.quote} locale={locale} />
            </blockquote>
            <figcaption>
              {item.photo && (
                <span class="photo">
                  <Img image={item.photo} locale={locale} widths={[48, 96]} sizes="48px" />
                </span>
              )}
              <span>
                <span class="name">{item.name}</span>
                <span class="role">{pick(item.role, locale)}</span>
              </span>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</SectionFrame>

<style>
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .quote {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    height: 100%;
    margin: 0;
    padding: 22px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-inline-start: 2px solid var(--accent);
    border-radius: 10px;
  }
  blockquote {
    margin: 0;
    font-size: 17px;
  }
  blockquote :global(p) {
    margin: 0;
  }
  blockquote :global(p + p) {
    margin-top: 8px;
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .photo {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .name {
    display: block;
    font-weight: 700;
    font-size: 15px;
  }
  .role {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
</style>
