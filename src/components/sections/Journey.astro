---
import RichText from "../layout/RichText.astro";
import { anchorFor } from "../../lib/sections";
import { pick } from "../../lib/localize";
import type { Content } from "../../content/repository";
import type { SectionOf } from "../../content/schemas/registry";
import type { Locale } from "../../i18n/locales";

interface Props {
  section: SectionOf<"journey">;
  locale: Locale;
  content: Content;
}

const { section, locale } = Astro.props;
const titleId = `${anchorFor(section.id)}-title`;
const title = pick(section.title, locale);
---

{/*
  Without JavaScript the track scrolls sideways on wide screens and stacks into
  a vertical list at ≤760px (pure CSS). The motion layer pins and scrubs it.
  The rail lives inside the track, so it always spans every stop.
*/}
<section
  id={anchorFor(section.id)}
  data-section={section.type}
  data-animate={String(section.animate)}
  data-journey
  class="journey"
  aria-labelledby={titleId}
>
  <div class="shell head">
    {
      section.heading ? (
        <>
          <div class="label" data-typer><span aria-hidden="true">//</span> {title}</div>
          <h2 id={titleId}>{pick(section.heading, locale)}</h2>
        </>
      ) : (
        <h2 class="label" id={titleId} data-typer><span aria-hidden="true">//</span> {title}</h2>
      )
    }
  </div>
  {/* A keyboard-focusable scroll region while the track scrolls natively (no JS, wide screens). */}
  <div class="track-wrap" role="group" tabindex="0" aria-label={title}>
    <div class="track" data-journey-track>
      <div class="rail" aria-hidden="true"><i data-journey-rail></i></div>
      <ol class="stops">
        {
          section.stops.map((stop) => (
            <li class:list={["stop", stop.head && "head-commit"]}>
              <div class="yr">{pick(stop.year, locale)}{stop.head && " · HEAD"}</div>
              <h3>{pick(stop.heading, locale)}</h3>
              <p><RichText value={stop.text} locale={locale} inline /></p>
              <div class="where">{pick(stop.caption, locale)}</div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .journey {
    position: relative;
    overflow: hidden;
  }
  .head {
    padding-top: 96px;
    padding-bottom: 32px;
  }
  .head h2:not(.label) {
    font-size: clamp(32px, 4.5vw, 54px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 8px 0 0;
  }
  .track-wrap {
    position: relative;
    padding-bottom: 72px;
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }
  /* The section clips overflow, so draw the focus ring inside the region. */
  .track-wrap:focus-visible {
    outline-offset: -2px;
  }
  .track {
    position: relative;
    padding: 0 max(24px, calc((100vw - 1080px) / 2 + 24px));
    width: max-content;
  }
  .stops {
    display: flex;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rail {
    position: absolute;
    left: 0;
    right: 0;
    top: 46px;
    height: 2px;
    background: var(--line);
  }
  .rail i {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform-origin: 0 50%;
    display: block;
  }
  .stop {
    width: min(78vw, 380px);
    flex-shrink: 0;
    position: relative;
    padding-top: 76px;
  }
  .stop::before {
    content: "";
    position: absolute;
    top: 39px;
    left: 0;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  .stop.head-commit::before {
    background: var(--accent);
  }
  .yr {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent-text);
    position: absolute;
    top: 0;
    left: 0;
  }
  h3 {
    font-size: 24px;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.02em;
  }
  p {
    color: var(--muted);
    margin: 8px 0 0;
    font-size: 16px;
  }
  .where {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    margin-top: 12px;
  }
  @media (max-width: 760px) {
    .track {
      width: auto;
      padding: 0 24px;
    }
    .stops {
      flex-direction: column;
      gap: 0;
    }
    .rail {
      display: none;
    }
    .stop {
      width: auto;
      padding-top: 0;
      padding-left: 30px;
      padding-bottom: 28px;
      border-left: 2px solid var(--line);
      margin-left: 7px;
    }
    .stop::before {
      top: 2px;
      left: -9px;
    }
    .yr {
      position: static;
    }
  }
</style>
