---
import SectionHeading from "./ui/SectionHeading.astro";
import { education } from "../content/career";
import { useTranslations, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="education" class="section" aria-labelledby="education-heading">
  <div class="shell">
    <SectionHeading index="04" title={t.sections.education} id="education" />

    <ul class="list">
      {
        education.map((item) => (
          <li class="item" data-reveal>
            <p class="years">
              <time datetime={String(item.startYear)}>{item.startYear}</time>
              <span aria-hidden="true">—</span>
              <time datetime={String(item.endYear)}>{item.endYear}</time>
            </p>

            <div>
              <h3 class="degree">{t.education.degrees[item.id]}</h3>
              <p class="institution">
                {item.institutionUrl ? (
                  <a href={item.institutionUrl} target="_blank" rel="noopener noreferrer">
                    {item.institution}
                  </a>
                ) : (
                  item.institution
                )}
                <span class="location">{item.location}</span>
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .section {
    padding-block: var(--spacing-section);
    background-color: var(--color-surface);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 52rem;
  }

  .item {
    display: grid;
    gap: 0.75rem 2.5rem;
    padding-block: 1.75rem;
    border-block-start: 1px solid var(--color-hairline);
  }

  @media (min-width: 40rem) {
    .item {
      grid-template-columns: 10rem minmax(0, 1fr);
      align-items: baseline;
    }
  }

  .years {
    font-size: var(--text-eyebrow);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums;
    display: flex;
    gap: 0.5rem;
  }

  .degree {
    font-size: var(--text-heading);
  }

  .institution {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-block-start: 0.35rem;
    font-size: var(--text-small);
  }

  .institution a {
    border-block-end: 1px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-in-out-quart);
  }

  .institution a:hover {
    border-block-end-color: var(--color-accent);
  }

  .location {
    color: var(--color-ink-muted);
  }
</style>
