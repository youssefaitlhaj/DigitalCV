---
import Frame from "./Frame.astro";
import MoreOnline from "./MoreOnline.astro";
import DateRange from "../layout/DateRange.astro";
import RichText from "../layout/RichText.astro";
import { pick } from "../../lib/localize";
import { displayUrl } from "../../lib/urls";
import { forPdf, pdfEntries } from "../../lib/pdf";
import type { Content } from "../../content/repository";
import type { SectionOf } from "../../content/schemas/registry";
import type { Locale } from "../../i18n/locales";

interface Props {
  section: SectionOf<"cards">;
  locale: Locale;
  content: Content;
}

const { section, locale, content } = Astro.props;
const { site } = content;
const { labels } = site;
const now = new Date();
const items = pdfEntries(section.items);
---

{/*
  Projects as a compact list, not the site's cards: per project a line with
  name, role and dates, the description (its short PDF version where there is
  one), then the technologies and links in small type. Only the projects
  marked "Show in PDF" are printed. A confidential project prints no links and
  a `confidential` badge, as on the site.
*/}
{
  items.length > 0 && (
    <Frame section={section} locale={locale}>
      <ul class="p-list projects">
        {items.map((item) => {
          const links = item.confidential ? undefined : item.links;
          return (
            <li class="project p-item">
              <div class="top">
                <h3>{pick(item.name, locale)}</h3>
                <span class="role p-muted">{pick(item.role, locale)}</span>
                {item.confidential && <span class="p-ref">{pick(labels.confidential, locale)}</span>}
                {(item.start || item.end) && (
                  <span class="p-meta date">
                    <DateRange start={item.start} end={item.end} locale={locale} labels={labels} now={now} />
                  </span>
                )}
              </div>
              <div class="desc p-rich">
                <RichText value={forPdf(item.description, item.pdfDescription)} locale={locale} />
              </div>
              {(item.tech.length > 0 || links?.code || links?.live) && (
                <div class="foot p-meta">
                  {item.tech.length > 0 && <span>{item.tech.join(" · ")}</span>}
                  {links?.code && (
                    <span>
                      {pick(labels.codeLink, locale)}{" "}
                      <a class="p-link" href={links.code} data-bare-url>{displayUrl(links.code)}</a>
                    </span>
                  )}
                  {links?.live && (
                    <span>
                      {pick(labels.liveLink, locale)}{" "}
                      <a class="p-link" href={links.live} data-bare-url>{displayUrl(links.live)}</a>
                    </span>
                  )}
                </div>
              )}
            </li>
          );
        })}
      </ul>
      <MoreOnline section={section} locale={locale} site={site} shown={items.length} total={section.items.length} />
    </Frame>
  )
}

<style>
  .projects {
    display: flex;
    flex-direction: column;
    gap: 2.5mm;
  }
  .project {
    overflow-wrap: anywhere;
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 2mm;
  }
  h3 {
    margin: 0;
    font-size: 10.5pt;
    font-weight: 700;
    line-height: 1.3;
  }
  .role {
    font-size: 8.5pt;
  }
  .role::before {
    content: "·";
    margin-inline-end: 2mm;
    color: var(--accent-text);
  }
  .date {
    margin-inline-start: auto;
    white-space: nowrap;
  }
  .desc {
    margin-top: 0.6mm;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0 4mm;
    margin-top: 0.8mm;
  }
</style>
