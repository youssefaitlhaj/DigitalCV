---
import Frame from "./Frame.astro";
import MoreOnline from "./MoreOnline.astro";
import { forPdf, pdfEntries } from "../../lib/pdf";
import RichText from "../layout/RichText.astro";
import { pick } from "../../lib/localize";
import type { Content } from "../../content/repository";
import type { SectionOf } from "../../content/schemas/registry";
import type { Locale } from "../../i18n/locales";

interface Props {
  section: SectionOf<"quotes">;
  locale: Locale;
  content: Content;
}

const { section, locale, content } = Astro.props;
const items = pdfEntries(section.items);
---

{/* Quotes marked "Show in PDF", without photos (the CV stays compact), each in its short PDF version where there is one. */}
{
  items.length > 0 && (
    <Frame section={section} locale={locale}>
      <ul class="p-list quotes">
        {
          items.map((item) => (
            <li class="p-item">
              <figure class="quote">
                <blockquote class="p-rich">
                  <RichText value={forPdf(item.quote, item.pdfQuote)} locale={locale} />
                </blockquote>
                <figcaption>
                  <span class="name">{item.name}</span>
                  <span class="p-meta">{pick(item.role, locale)}</span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
      <MoreOnline section={section} locale={locale} site={content.site} shown={items.length} total={section.items.length} />
    </Frame>
  )
}

<style>
  .quotes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3mm;
  }
  .quote {
    height: 100%;
    margin: 0;
    padding: 3mm 3.5mm;
    background: var(--panel);
    border: 0.75pt solid var(--line);
    border-inline-start: 2pt solid var(--accent);
    border-radius: 2mm;
  }
  blockquote {
    margin: 0;
  }
  figcaption {
    margin-top: 2mm;
  }
  .name {
    display: block;
    font-weight: 700;
    font-size: 8.5pt;
  }
</style>
