---
import { anchorFor } from "../../lib/sections";
import { pick } from "../../lib/localize";
import { resolveStat } from "../../lib/stats";
import type { Content } from "../../content/repository";
import type { SectionOf } from "../../content/schemas/registry";
import type { Locale } from "../../i18n/locales";

interface Props {
  section: SectionOf<"stats">;
  locale: Locale;
  content: Content;
}

const { section, locale, content } = Astro.props;
const now = new Date();
---

{/* One compact row of the site's numbers, resolved at build time. */}
<section id={anchorFor(section.id)} data-section={section.type} class="p-stats p-item" style={`--cols: ${section.items.length}`}>
  {
    section.items.map((item) => (
      <div class="stat">
        <span class="n">{resolveStat(item, content.page, now)}</span>
        <span class="l">{pick(item.label, locale)}</span>
      </div>
    ))
  }
</section>

<style>
  .p-stats {
    display: grid;
    grid-template-columns: repeat(var(--cols, 4), 1fr);
    margin-top: 4.5mm;
    border-top: 0.75pt solid var(--line);
    border-bottom: 0.75pt solid var(--line);
  }
  .stat {
    display: flex;
    flex-direction: column;
    padding: 2.5mm 3.5mm;
    border-inline-start: 0.75pt solid var(--line);
  }
  .stat:first-child {
    border-inline-start: 0;
    padding-inline-start: 0;
  }
  .n {
    font-family: var(--font-mono);
    font-size: 17pt;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: var(--accent);
  }
  .l {
    color: var(--muted);
    font-size: 7.5pt;
    line-height: 1.3;
    margin-top: 0.8mm;
  }
</style>
