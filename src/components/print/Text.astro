---
import Frame from "./Frame.astro";
import RichText from "../layout/RichText.astro";
import type { Content } from "../../content/repository";
import type { SectionOf } from "../../content/schemas/registry";
import type { Locale } from "../../i18n/locales";

interface Props {
  section: SectionOf<"text">;
  locale: Locale;
  content: Content;
}

const { section, locale } = Astro.props;
---

<Frame section={section} locale={locale}>
  <div class="prose">
    {
      section.paragraphs.map((paragraph) => (
        <div class="p-item p-rich">
          <RichText value={paragraph} locale={locale} />
        </div>
      ))
    }
  </div>
</Frame>

<style>
  .prose > * + * {
    margin-top: 1.5mm;
  }
</style>
