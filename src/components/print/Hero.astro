---
import Img from "../layout/Img.astro";
import { anchorFor } from "../../lib/sections";
import { pick } from "../../lib/localize";
import { displayUrl } from "../../lib/urls";
import { pathFor } from "../../i18n/locales";
import type { Content } from "../../content/repository";
import type { SectionOf } from "../../content/schemas/registry";
import type { Locale } from "../../i18n/locales";

interface Props {
  section: SectionOf<"hero">;
  locale: Locale;
  content: Content;
}

const { section, locale, content } = Astro.props;
const { site } = content;
// The website in the PDF's own language: the German CV links to /de/.
const website = new URL(pathFor(locale), site.siteUrl).href;
const city = pick(site.location, locale).split(",")[0].trim().toLowerCase();
---

{/*
  The CV header: name, role, location, email, LinkedIn and the website. Never
  a phone number or a postal address. The email halves are joined by the print
  layout's script; the LinkedIn and website texts are their URLs, so they are
  not printed twice.
*/}
<header id={anchorFor(section.id)} data-section={section.type} class="p-hero p-item">
  <div class="txt">
    <div class="prompt"><b>~/{city}</b> $ {section.prompt}</div>
    <h1>{site.name}</h1>
    <div class="role">{pick(section.role, locale)}</div>
    <p class="sub">{pick(section.subtitle, locale)}</p>
    <ul class="contact">
      <li>{pick(site.location, locale)}</li>
      <li>
        <a href="#" data-email data-email-user={site.email.user} data-email-domain={site.email.domain}><span data-email-text></span></a>
      </li>
      <li><a href={site.linkedin} data-bare-url>{displayUrl(site.linkedin)}</a></li>
      <li><a href={website} data-bare-url>{displayUrl(website)}</a></li>
    </ul>
  </div>
  {
    site.pdf.includePortrait && (
      <div class="photo">
        <Img image={section.portrait} locale={locale} widths={[463]} sizes="463px" eager />
      </div>
    )
  }
</header>

<style>
  .p-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8mm;
    align-items: center;
    padding-bottom: 4.5mm;
  }
  .prompt {
    font-family: var(--font-mono);
    font-size: 8pt;
    color: var(--muted);
    margin-bottom: 1.5mm;
  }
  .prompt b {
    color: var(--accent-text);
    font-weight: 500;
  }
  h1 {
    font-size: 28pt;
    font-weight: 700;
    line-height: 1;
    /* Tighter than body text, but loose enough that PDF text keeps its word gaps. */
    letter-spacing: -0.015em;
    word-spacing: 0.05em;
    margin: 0;
  }
  .role {
    font-size: 13pt;
    font-weight: 600;
    color: var(--accent-text);
    margin-top: 2.5mm;
  }
  .sub {
    color: var(--muted);
    font-size: 9.5pt;
    max-width: 125mm;
    margin: 1.5mm 0 0;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2.5mm;
    list-style: none;
    margin: 3mm 0 0;
    padding: 0;
    font-size: 9pt;
    font-weight: 500;
  }
  .contact li {
    white-space: nowrap;
  }
  .contact li + li::before {
    content: "·";
    color: var(--accent-text);
    margin-inline-end: 2.5mm;
  }
  .photo {
    width: 30mm;
    aspect-ratio: 4 / 5;
    border-radius: 2.5mm;
    overflow: hidden;
  }
  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
