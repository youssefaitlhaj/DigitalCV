---
import Frame from "./Frame.astro";
import { pick, pickText } from "../../lib/localize";
import type { Content } from "../../content/repository";
import type { SectionOf } from "../../content/schemas/registry";
import type { Locale } from "../../i18n/locales";

interface Props {
  section: SectionOf<"tags">;
  locale: Locale;
  content: Content;
}

const { section, locale } = Astro.props;
---

<Frame section={section} locale={locale}>
  <div class="groups">
    {
      section.groups
        .filter((group) => group.items.length > 0)
        .map((group) => (
          <div class="group p-item">
            <h3>{pick(group.title, locale)}</h3>
            <ul class="p-chips">
              {group.items.map((item) => (
                <li class="p-chip">
                  {pickText(item.label, locale)}
                  {item.level && <i>{pickText(item.level, locale)}</i>}
                </li>
              ))}
            </ul>
          </div>
        ))
    }
  </div>
</Frame>

<style>
  .groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3.5mm 5mm;
  }
  h3 {
    font-size: 8.5pt;
    font-weight: 700;
    margin: 0 0 1.5mm;
  }
</style>
