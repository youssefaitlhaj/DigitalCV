---
import Base from "../components/layout/Base.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import SectionRenderer from "../components/sections/SectionRenderer.astro";
import { getContent } from "../content/repository";
import { visibleSections } from "../lib/sections";
import { personJsonLd, serializeJsonLd } from "../lib/seo";

const locale = "en" as const;
const content = getContent();
const { site, page } = content;
---

<Base locale={locale} title={site.meta.title[locale]} description={site.meta.description[locale]}>
  <script slot="head" type="application/ld+json" is:inline set:html={serializeJsonLd(personJsonLd(content, locale))} />
  <Header content={content} locale={locale} />
  <main id="main">
    {visibleSections(page.sections).map((section) => <SectionRenderer section={section} locale={locale} content={content} />)}
  </main>
  <Footer content={content} locale={locale} />
</Base>
