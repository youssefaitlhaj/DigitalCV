---
import Base from "../components/layout/Base.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import Statement from "../components/sections/Statement.astro";
import Stats from "../components/sections/Stats.astro";
import Journey from "../components/sections/Journey.astro";
import Contact from "../components/sections/Contact.astro";
import { getContent } from "../content/repository";
import { visibleSections } from "../lib/sections";

const locale = "en" as const;
const content = getContent();
const { site, page } = content;
// TEMPORARY until Task 9's SectionRenderer: only the fixed sections render.
const sections = visibleSections(page.sections);
---

<Base locale={locale} title={site.meta.title[locale]} description={site.meta.description[locale]}>
  <Header content={content} locale={locale} />
  <main id="main">
    {
      sections.map((section) => {
        const props = { locale, content };
        switch (section.type) {
          case "hero":
            return <Hero section={section} {...props} />;
          case "statement":
            return <Statement section={section} {...props} />;
          case "stats":
            return <Stats section={section} {...props} />;
          case "journey":
            return <Journey section={section} {...props} />;
          case "contact":
            return <Contact section={section} {...props} />;
          default:
            return null;
        }
      })
    }
  </main>
  <Footer content={content} locale={locale} />
</Base>
